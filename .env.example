# ==========================================
# BizConnect - Root Environment Template
# ==========================================
# Copy this file to .env for local development overrides.
# DO NOT commit real secrets or credentials to Git.

# --- Backend Settings (Spring Boot on Render / Local) ---
# Aiven MySQL Connection URL (SSL REQUIRED)
# Format: jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED&serverTimezone=UTC
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bizconnect_db?sslMode=REQUIRED&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_secure_password

# JWT Secret (Base64-encoded 256-bit / 32-byte minimum)
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_minimum_256_bits
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Production frontend URL when deployed; localhost is enabled by default)
# Example for production: CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app
CORS_ALLOWED_ORIGINS=

# Server Port (Render automatically sets PORT)
PORT=8080

# --- Frontend Settings (React + Vite on Vercel) ---
# Set to your deployed Render backend URL on Vercel (leave empty for local Vite proxy)
VITE_API_BASE_URL=
