# Backend Environment Template (.env.example)
# Copy to .env in this directory (or project root) for local development.

# Database Credentials
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bizconnect_db?sslMode=REQUIRED&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_minimum_256_bits
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Production frontend URL when deployed; localhost is enabled by default)
# Example for production: CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app
CORS_ALLOWED_ORIGINS=

# Server Port (Render sets this dynamically)
PORT=8080
