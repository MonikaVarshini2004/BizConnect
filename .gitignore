# ==========================================
# BizConnect - Git Ignore Configuration
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.local.properties
application-local.properties

# Backend (Maven & Eclipse)
backend/target/
backend/bin/
backend/.classpath
backend/.project
backend/.settings/
target/
bin/
*.class

# Frontend (Node & Vite)
frontend/node_modules/
frontend/dist/
frontend/.project
frontend/.settings/
node_modules/
dist/

# Eclipse workspace metadata
.metadata/

# IDE & Editor files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS specific files
.DS_Store
Thumbs.db

# Sensitive certificates and keys
*.pem
*.key
*.p12
*.jks
